<% s = RedmineNiimbotLabels.settings %>
<p>
  <label for="settings_width_mm"><%= l(:field_niimbot_labels_width_mm) %></label>
  <%= number_field_tag 'settings[width_mm]', s[:width_mm], id: 'settings_width_mm', min: 10, max: 100 %>
</p>
<p>
  <label for="settings_height_mm"><%= l(:field_niimbot_labels_height_mm) %></label>
  <%= number_field_tag 'settings[height_mm]', s[:height_mm], id: 'settings_height_mm', min: 10, max: 100 %>
</p>
<p>
  <label for="settings_density"><%= l(:field_niimbot_labels_density) %></label>
  <%= number_field_tag 'settings[density]', s[:density], id: 'settings_density', min: 1, max: 5 %>
  <em class="info"><%= l(:text_niimbot_labels_density_hint) %></em>
</p>
<p>
  <label for="settings_title_field_id"><%= l(:field_niimbot_labels_title_field) %></label>
  <%= select_tag 'settings[title_field_id]',
                 options_for_select([[l(:label_niimbot_labels_title_subject), '']] +
                                    IssueCustomField.where(field_format: RedmineNiimbotLabels::TITLE_FIELD_FORMATS).
                                      sorted.map {|f| [f.name, f.id.to_s]},
                                    s[:title_field_id].to_s),
                 id: 'settings_title_field_id' %>
  <em class="info"><%= l(:text_niimbot_labels_title_field_hint) %></em>
</p>
<p>
  <em class="info"><%= l(:text_niimbot_labels_host_hint, url: RedmineNiimbotLabels.base_url) %></em>
</p>
