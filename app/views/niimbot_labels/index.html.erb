<% html_title l(:label_niimbot_labels) %>
<%= render partial: 'niimbot_labels/assets' %>

<h2><%= l(:label_niimbot_labels) %></h2>

<% if (host = RedmineNiimbotLabels.host_mismatch(request)) %>
  <p class="warning"><%= l(:warning_niimbot_labels_host_mismatch, host: host) %></p>
<% end %>

<%= tag.div class: 'niimbot-page', data: {
      niimbot_print_page: true,
      config: RedmineNiimbotLabels.client_config.merge(labels: @labels).to_json,
      label_url: niimbot_label_path(id: 0).sub(/0\z/, 'ID')
    } do %>
  <div class="niimbot-printer">
    <span class="niimbot-printer-status"></span>
    <button type="button" class="niimbot-connect"><%= l(:button_niimbot_labels_connect) %></button>
    <button type="button" class="niimbot-disconnect" hidden><%= l(:button_niimbot_labels_disconnect) %></button>
    <button type="button" class="niimbot-print-all" disabled><%= l(:button_niimbot_labels_print_all) %></button>
  </div>
  <p class="niimbot-message"></p>

  <form class="niimbot-add">
    <input type="text" inputmode="numeric" autocomplete="off"
           placeholder="<%= l(:field_niimbot_labels_issue_number) %>"
           aria-label="<%= l(:field_niimbot_labels_issue_number) %>">
    <button type="submit"><%= l(:button_niimbot_labels_add) %></button>
  </form>

  <ul class="niimbot-queue"></ul>
  <p class="niimbot-empty nodata"><%= l(:text_niimbot_labels_empty) %></p>
<% end %>
