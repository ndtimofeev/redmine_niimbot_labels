<%# Only the selected issues whose project has label printing; the print page
    opens in the project of the first of them. %>
<% printable = issues.to_a.select {|issue| RedmineNiimbotLabels.printable?(issue)} %>
<% if printable.any? %>
  <li>
    <%= context_menu_link l(:label_niimbot_labels_print_selected),
                          project_niimbot_labels_path(printable.first.project, ids: printable.map(&:id).join(',')),
                          class: 'icon icon-print' %>
  </li>
<% end %>
